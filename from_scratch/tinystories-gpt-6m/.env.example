# Copy this file to .env and fill in your real token — .env is gitignored and never
# committed. Get a token (needs "write" permission) at:
#   https://huggingface.co/settings/tokens
#
#   cp .env.example .env
#   # then edit .env and paste your real token in place of the placeholder below

HF_TOKEN=hf_your_token_here
