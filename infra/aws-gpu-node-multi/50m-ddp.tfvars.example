# cp 50m-ddp.tfvars.example 50m-ddp.tfvars   (50m-ddp.tfvars is gitignored)
#
# Deploy this file against the "50m-ddp" Terraform workspace, not "default" —
# "default" holds custom-gpt-350m-ddp's state (its bucket/IAM/SG live there).
# Same module code, separate state, zero infra duplication:
#
#   terraform workspace select 50m-ddp   # or: terraform workspace new 50m-ddp
#   terraform plan  -var-file=50m-ddp.tfvars
#   terraform apply -var-file=50m-ddp.tfvars

region  = "us-east-1"
project = "mini-llm-gpu-50m-ddp"   # distinct from 350m-ddp's "mini-llm-gpu-ddp" — separate bucket/SG/key-pair names, same AWS account

# ---- compute ---------------------------------------------------------------
# g6.xlarge (L4) is the module default and cheaper (~$0.80/hr vs A10G's ~$1.01/hr),
# but has hit Server.InsufficientInstanceCapacity repeatedly on this account —
# both custom-gpt-350m-ddp (2026-08-31) and this project (2026-09-01) fell back
# to g5.xlarge (A10G) after L4 failed for several minutes with zero instances
# created. Worth retrying L4 first each time; fall back if it stalls.
instance_type  = "g5.xlarge" # A10G 24GB — confirmed working on this account
root_volume_gb = 100

# Leave unset to auto-pick a default-VPC subnet in an AZ that actually offers
# instance_type (see variables.tf's subnet_id description). Set explicitly only
# once you've confirmed a specific subnet/AZ combination actually gets capacity
# for your account — do not copy one from another account's docs, subnet ids are
# account-specific and won't resolve elsewhere.
# subnet_id = "subnet-xxxxxxxxxxxxxxxxx"

use_spot = false

# ---- access ------------------------------------------------------------------
public_key_path      = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"
# allowed_ssh_cidrs = ["203.0.113.10/32"]   # leave empty to auto-detect this machine's public IP

# ---- storage / bootstrap ----------------------------------------------------
create_bucket = true

repo_url       = "https://github.com/shukla-surendra/tiny_llm.git"
project_subdir = "from_scratch/custom-gpt-50m-ddp"

corpus_prefix    = "50m-ddp/corpus/"
checkpoint_prefix = "50m-ddp/checkpoints/"
# No tokenizer_prefix: this model uses GPT-2's off-the-shelf tiktoken encoding
# (vocab_size=50257), which ships inside the pip package itself — unlike
# custom-gpt-350m-ddp's project-trained 32,768-vocab tokenizer.json, there is no
# separate tokenizer file to sync to either node.
tokenizer_prefix = ""

# ---- training budget ---------------------------------------------------------
# Phase 1 (pretrain) target, from `gpt-tokenize` on 2026-09-01 against the 30GB
# pretrain corpus truncated to a ~4.7GB prefix (data/train.txt, line-boundary
# safe cut; full corpus was far more than this 51.48M-param model's
# Chinchilla-optimal ~1.03B tokens needs — see docs/RESUME_POINT_2026-08-31.md).
# 996,638,534 tokens exactly — essentially one full epoch at Chinchilla-optimal,
# no need to inflate this the way 350m-ddp's 4x-epoch budget did (that model
# needs ~20x more tokens per param at its larger size). Recompute for your own
# corpus build rather than reusing this number as-is.
target_tokens = 996638534

# Verified on real A10G hardware 2026-09-01: a 40-step single-GPU smoke test
# completed cleanly with real headroom (~13GB of 23GB used, including both eval
# passes). Re-verify on whatever instance_type you actually deploy before
# trusting these — see docs/MULTI_NODE_DDP.md and the 350m-ddp OOM saga
# (docs/RUN_LOG_2026-08-31.md in that project) for why this matters.
batch_size       = 16
grad_accum_steps = 16

# ---- cost guards ---------------------------------------------------------------
checkpoint_sync_minutes = 15
idle_shutdown_minutes   = 0   # disabled deliberately for multi-node — see variables.tf

monthly_budget_usd = 60
# budget_alert_email = "you@example.com"
