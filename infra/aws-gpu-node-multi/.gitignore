# Terraform working dir and providers
.terraform/
.terraform.lock.hcl.bak

# State: contains resource ids and, for some resources, secrets. Never commit it.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Real values (may hold your home IP, email, bucket names, subnet/AZ ids). Was
# just "terraform.tfvars" (350m-ddp's file) — 50m-ddp.tfvars slipped through that
# narrow match and got committed with a real subnet id on 2026-09-01. Broadened
# to *.tfvars so any future per-workspace file is covered automatically.
*.tfvars
*.auto.tfvars
!*.tfvars.example

# Saved plans
*.tfplan
crash.log
crash.*.log
